# Set these in the server process environment; never use a VITE_ prefix.
DAYBOOK_DB=daybook/data/daybook.sqlite
DAYBOOK_PORT=3001
# Optional. Without this, the assistant reports that it is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
