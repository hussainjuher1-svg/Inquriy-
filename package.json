{
  "name": "vite-react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "daybook:api": "node daybook/server/index.mjs",
    "daybook:dev": "concurrently -k \"npm:daybook:api\" \"vite --host 0.0.0.0 --config daybook/vite.config.ts\"",
    "daybook:test": "node --test daybook/test/*.test.mjs",
    "daybook:test:ui": "vitest run daybook/test/ui.test.tsx",
    "daybook:web": "vite --host 0.0.0.0 --config daybook/vite.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "express": "^5.3.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
